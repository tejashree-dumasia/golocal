# Server Configuration
PORT=3000
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/golocal

CLOUDINARY_CLOUD_NAME=cloudname
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=asdf-qwerty

# Resend API (For sending trip invites)
# Get this from https://resend.com/
RESEND_API_KEY=re_your_resend_api_key_here

# Note: Firebase Admin requires a 'firebase-admin-key.json' file in the backend root directory.
# You can generate this from Firebase Console -> Project Settings -> Service Accounts.